{
    "name": "@terascope/standard-asset-apis",
    "displayName": "Standard Asset Apis",
    "version": "2.2.1",
    "description": "A common set of tools for data processing",
    "homepage": "https://github.com/terascope/standard-assets",
    "repository": "git@github.com:terascope/standard-assets.git",
    "license": "MIT",
    "author": "Terascope, LLC <info@terascope.io>",
    "type": "module",
    "main": "dist/src/index.js",
    "typings": "dist/src/index.d.ts",
    "files": [
        "dist/src/**/*"
    ],
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "build:watch": "tsc --project tsconfig.json --watch",
        "test": "ts-scripts test . --",
        "test:debug": "ts-scripts test --debug . --",
        "test:encrypted": "echo 'No encrypted tests for standard assets'",
        "test:watch": "ts-scripts test --watch . --"
    },
    "dependencies": {
        "@sindresorhus/fnv1a": "~3.1.0",
        "@terascope/core-utils": "~2.11.1",
        "@terascope/job-components": "~2.13.1"
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "@terascope/scripts": "~2.16.1",
        "@types/jest": "~30.0.0",
        "@types/node": "~25.9.2",
        "jest": "~30.4.2",
        "jest-extended": "~7.0.0",
        "jest-fixtures": "~0.6.0",
        "ts-jest": "~29.4.11",
        "typescript": "~5.9.3"
    },
    "engines": {
        "node": ">=22.21.1",
        "pnpm": ">=11.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "srcMain": "src/index.ts",
    "terascope": {
        "enableTypedoc": true,
        "testSuite": "unit"
    }
}
